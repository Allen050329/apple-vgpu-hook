#version 450

// Present-proxy stats reduction — the zero-copy oracle.
//
// Reduces a resident BGRA8 present frame to a 32-byte stats block so the
// always-on present proxies never need the framebuffer on the CPU. Replaces the
// full-frame `read_resident_bgra` readback: this dispatch runs on the GPU that
// already holds the frame, and only the reduced block crosses the bus.
//
// BYTE-EXACT with the CPU reference implementations it replaces — that equality
// is asserted by a unit test, so this file must not drift from them:
//   * `draw_log::bgra_present_stats`  -> byte_nz, byte_max, rgb_nz, max_rgb, px0
//   * `present_proxy::edge_energy_bgra` -> edge_sum (the CPU applies the >> 8)
//   * `content_stats::copy_color8_with_stats` -> rgb_nz, max_rgb (as rgb_max),
//     alpha_nz, alpha_opaque. This is what lets the guest-store scatter path
//     drop its full-frame CPU readback: the stats it needed now come from here.
//
// The source image is bound SAMPLED (resident targets already carry
// VK_IMAGE_USAGE_SAMPLED_BIT; binding as STORAGE would force adding the usage
// to every registry target and break the target_free recycle pool's identical-
// usage assumption). `texelFetch` is an exact texel read: no filtering, no
// normalization surprise beyond the unorm8 round-trip below.
//
// No push constants: the engine's pipeline layout carries set layouts only, so
// geometry comes from textureSize().

layout(local_size_x = 16, local_size_y = 16) in;

// Separate texture + sampler, NOT sampler2D: the engine's descriptor layout
// emits SAMPLED_IMAGE and SAMPLER as distinct bindings and has no
// COMBINED_IMAGE_SAMPLER path, so a combined declaration would not match.
layout(set = 0, binding = 0) uniform texture2D src_tex;
layout(set = 0, binding = 1) uniform sampler src_samp;

// std430 so the Rust side can read it as a packed #[repr(C)] u32 block.
layout(std430, set = 0, binding = 2) buffer StatsBuf {
    uint byte_nz;   // nonzero bytes across ALL four channels
    uint byte_max;  // max byte over all four channels
    uint rgb_nz;    // pixels whose max(B,G,R) != 0
    uint max_rgb;   // max of B/G/R over all pixels
    uint edge_sum;  // summed |luma(x) - luma(x+1)|, pre->>8
    uint px0;       // first pixel packed B | G<<8 | R<<16 | A<<24
    uint out_w;     // echoed geometry: lets the host reject a stale block
    uint out_h;
    uint alpha_nz;      // pixels whose A != 0
    uint alpha_opaque;  // pixels whose A == 255
} stats;

// Workgroup-local accumulators: one atomic per counter per workgroup instead of
// one per invocation (256x less global contention).
shared uint s_byte_nz;
shared uint s_byte_max;
shared uint s_rgb_nz;
shared uint s_max_rgb;
shared uint s_edge;
shared uint s_alpha_nz;
shared uint s_alpha_opaque;

// unorm8 -> exact byte. The +0.5 recovers the integer the texel was built from;
// unorm8 round-trip is exact per spec, so this equals the CPU's raw byte.
uint chan(float v) {
    return uint(v * 255.0 + 0.5);
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        s_byte_nz = 0u;
        s_byte_max = 0u;
        s_rgb_nz = 0u;
        s_max_rgb = 0u;
        s_edge = 0u;
        s_alpha_nz = 0u;
        s_alpha_opaque = 0u;
    }
    barrier();

    ivec2 size = textureSize(sampler2D(src_tex, src_samp), 0);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);

    if (p.x < size.x && p.y < size.y) {
        vec4 t = texelFetch(sampler2D(src_tex, src_samp), p, 0);
        // .r/.g/.b/.a are the colour components; for B8G8R8A8_UNORM they map to
        // memory bytes [2]/[1]/[0]/[3]. Only px0 below cares about that order —
        // the counts and maxima are order-independent.
        uint r = chan(t.r);
        uint g = chan(t.g);
        uint b = chan(t.b);
        uint a = chan(t.a);

        uint nz = uint(b != 0u) + uint(g != 0u) + uint(r != 0u) + uint(a != 0u);
        if (nz != 0u) {
            atomicAdd(s_byte_nz, nz);
        }
        atomicMax(s_byte_max, max(max(r, g), max(b, a)));

        uint m = max(max(b, g), r);
        if (m != 0u) {
            atomicAdd(s_rgb_nz, 1u);
            atomicMax(s_max_rgb, m);
        }

        // Alpha occupancy, matching `copy_color8_with_stats_scalar`: `alpha_nz`
        // counts A != 0, `alpha_opaque` counts A == 255 (fully opaque only).
        if (a != 0u) {
            atomicAdd(s_alpha_nz, 1u);
        }
        if (a == 255u) {
            atomicAdd(s_alpha_opaque, 1u);
        }

        if (p.x == 0 && p.y == 0) {
            // Single writer (exactly one invocation satisfies this), no race.
            stats.px0 = b | (g << 8) | (r << 16) | (a << 24);
            stats.out_w = uint(size.x);
            stats.out_h = uint(size.y);
        }

        // Edge energy. The CPU walks y in steps of 4 and x in steps of 4, and at
        // each step compares pixel x against x+1 (NOT x+4) — mirror that exactly.
        // It also returns 0 outright for frames below 8x8.
        if (size.x >= 8 && size.y >= 8
            && (p.x & 3) == 0 && (p.y & 3) == 0 && (p.x + 1) < size.x) {
            vec4 t1 = texelFetch(sampler2D(src_tex, src_samp), ivec2(p.x + 1, p.y), 0);
            uint l0 = (r + (g << 1) + b) >> 2;
            uint l1 = (chan(t1.r) + (chan(t1.g) << 1) + chan(t1.b)) >> 2;
            atomicAdd(s_edge, uint(abs(int(l0) - int(l1))));
        }
    }

    barrier();

    if (gl_LocalInvocationIndex == 0u) {
        atomicAdd(stats.byte_nz, s_byte_nz);
        atomicMax(stats.byte_max, s_byte_max);
        atomicAdd(stats.rgb_nz, s_rgb_nz);
        atomicMax(stats.max_rgb, s_max_rgb);
        atomicAdd(stats.edge_sum, s_edge);
        atomicAdd(stats.alpha_nz, s_alpha_nz);
        atomicAdd(stats.alpha_opaque, s_alpha_opaque);
    }
}
